{
  "buildCommand": "pnpm install && pnpm --filter @workspace/jaiye-directory run build",
  "outputDirectory": "artifacts/jaiye-directory/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
