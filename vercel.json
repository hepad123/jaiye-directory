{
  "buildCommand": "pnpm install && pnpm --filter @workspace/jaiye-directory run build",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/jaiye-directory/dist/public",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
